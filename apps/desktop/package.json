{
  "name": "@pos/desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "dev": "ELECTRON_START_URL=http://localhost:5173 electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.hobocustomsoftware.retailpos",
    "productName": "Retail POS - HoBo Custom Software",
    "copyright": "Copyright © 2026-present HoBo Custom Software",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "package.json"
    ]
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json"
  ]
}